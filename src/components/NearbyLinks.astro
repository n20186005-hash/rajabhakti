---
import type { Lang } from '../i18n/ui';
import { topics } from '../i18n/topics';
interface Props { lang: Lang }
const { lang } = Astro.props;
const headings: Record<Lang, { eyebrow: string; title: string; desc: string; all: string }> = {
  en: { eyebrow: 'Beyond the monument', title: 'Nearby Hua Hin Attractions', desc: 'Pair the seven kings with beaches, historic landmarks, food markets and nature trails.', all: 'Browse every nearby attraction and travel guide' },
  th: { eyebrow: 'เที่ยวต่อจากอุทยาน', title: 'ที่เที่ยวใกล้เคียงในหัวหิน', desc: 'วางแผนเที่ยวชายหาด สถานที่ประวัติศาสตร์ ตลาดอาหาร และเส้นทางธรรมชาติ', all: 'ดูสถานที่เที่ยวและคู่มือทั้งหมด' },
  zh: { eyebrow: '周边探索', title: '华欣周边景点', desc: '将七大泰王纪念园与海滩、历史景点、夜市和自然步道串联成顺路行程。', all: '查看全部周边景点与旅行指南' },
};
const featured = ['nearby-suan-son-pradiphat-beach', 'nearby-khao-takiab', 'nearby-hua-hin-railway-station', 'nearby-cicada-market', 'nearby-pranburi-forest-park', 'nearby-hua-hin-beach'];
const nearby = featured.map((slug) => topics.find((t) => t.slug === slug && t.lang === lang)).filter((t) => t !== undefined);
const t = headings[lang];
---
<section id="nearby" class="py-16 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{t.eyebrow}</p>
    <h2 class="font-display text-2xl md:text-4xl text-teak mt-2">{t.title}</h2>
    <p class="text-ink/75 max-w-3xl mt-3">{t.desc}</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-8">
      {nearby.map((place) => (
        <a href={`/${lang}/${place.slug}/`} class="group rounded-xl overflow-hidden border border-gold/25 bg-white/80 hover:border-gold/70 transition-colors">
          <div class="h-44 overflow-hidden bg-teak/10">
            {place.images?.[0] && <img src={place.images[0].src} alt={place.images[0].alt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />}
          </div>
          <div class="p-5"><h3 class="font-display text-lg text-teak">{place.h1}</h3><p class="text-xs text-ink/65 mt-2">{place.description}</p><span class="mt-3 inline-block text-gold text-sm">{{en:'Read guide',th:'อ่านคู่มือ',zh:'阅读攻略'}[lang]} →</span></div>
        </a>
      ))}
    </div>
    <a href={`/${lang}/explore/`} class="inline-flex mt-7 text-teak font-medium underline underline-offset-4">{t.all} →</a>
  </div>
</section>
