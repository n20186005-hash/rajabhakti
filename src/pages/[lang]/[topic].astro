---
import { getI18n, languagesList, type Lang } from '../../i18n/ui';
import { topics, getTopic } from '../../i18n/topics';
import TopicLayout from '../../layouts/TopicLayout.astro';
import { siteConfig } from '../../config';

export function getStaticPaths() {
  return topics.map((t) => ({ params: { lang: t.lang, topic: t.slug } }));
}

const { lang, messages } = await getI18n(Astro.url);
const slug = Astro.params.topic as string;
const topic = getTopic(lang, slug);
if (!topic) return Astro.redirect(`/${lang}/`);
const mapsUrl = topic.mapUrl ?? siteConfig.mapsUrl;
const alternateLanguages=languagesList.filter(l=>getTopic(l,slug)).map(l=>({lang:l,path:`/${l}/${slug}/`}));
const labels:Record<Lang,Record<string,string>>={
en:{map:'View on Google Maps',about:'About the attraction',manager:'About the attraction and who manages it',basic:'Basic Visitor Information',destination:'Destination',area:'Area',hours:'Opening and admission',hoursText:'Confirm current hours, admission and access with the destination operator',navigation:'Navigation',navLink:'Open dedicated Google Maps search',photo:'Photography Spots and Observation Details',route:'Recommended Route: Step by Step',stay:'Where to Stay for This Visit',stayText:'Compare stays in central Hua Hin for dining and rail connections, Nong Kae for the southern coast, or Khao Takiab for beaches. Confirm the address and journey before booking.',feedback:'Visitor Feedback',feedbackText:'For recent experiences and visitor observations, open this destination’s own Google Maps listing. Ratings change and are not reproduced here.',reviews:'Read current visitor reviews',photos:'Photos of',faq:'Frequently asked questions',related:'Related guides',kings:'The seven kings at a glance'},
th:{map:'ดูแผนที่ Google Maps',about:'เกี่ยวกับสถานที่',manager:'เกี่ยวกับสถานที่และหน่วยงานที่ดูแล',basic:'ข้อมูลพื้นฐานสำหรับผู้เยี่ยมชม',destination:'สถานที่',area:'พื้นที่',hours:'เวลาเปิดและค่าเข้า',hoursText:'ตรวจสอบเวลาเปิด ค่าเข้า และการเข้าพื้นที่กับผู้ดูแลสถานที่',navigation:'การนำทาง',navLink:'เปิดแผนที่ Google Maps เฉพาะสถานที่',photo:'จุดถ่ายภาพและรายละเอียดน่าสังเกต',route:'เส้นทางแนะนำทีละขั้น',stay:'ที่พักสำหรับทริปนี้',stayText:'เปรียบเทียบที่พักในตัวเมืองหัวหินเพื่อร้านอาหารและสถานีรถไฟ ย่านหนองแกสำหรับชายฝั่งตอนใต้ หรือเขาตะเกียบสำหรับหาดทราย ตรวจสอบที่อยู่และเส้นทางก่อนจอง',feedback:'ความคิดเห็นผู้เยี่ยมชม',feedbackText:'อ่านประสบการณ์และภาพถ่ายล่าสุดจากรายการ Google Maps ของสถานที่นี้โดยตรง คะแนนและจำนวนรีวิวเปลี่ยนแปลงได้',reviews:'อ่านรีวิวล่าสุด',photos:'ภาพถ่าย',faq:'คำถามที่พบบ่อย',related:'คู่มือที่เกี่ยวข้อง',kings:'เจ็ดบูรพกษัตริย์โดยสรุป'},
zh:{map:'在 Google 地图查看位置',about:'关于景点',manager:'景点介绍与管理单位',basic:'游客基本信息',destination:'景点名称',area:'所在区域',hours:'开放与门票',hoursText:'开放时间、收费与通行安排请向景点管理方核实',navigation:'地图导航',navLink:'打开景点专属 Google 地图',photo:'拍摄机位与观察重点',route:'推荐路线：分步游览',stay:'附近住宿建议',stayText:'可根据行程选择华欣市中心（餐饮与铁路方便）、Nong Kae（前往南部海岸便利）或筷子山一带（靠近海滩）的住宿。预订前核对地址及交通。',feedback:'游客评价',feedbackText:'可在此景点自身的 Google 地图列表查看近期游览体验和照片。评分与评价数量会变化，本站不复制实时数据。',reviews:'查看近期游客评价',photos:'景点实景照片',faq:'常见问题',related:'相关攻略',kings:'七大泰王简介'}
};
const u=labels[lang];
const extraLabels:Record<Lang,Record<string,string>>={
 en:{category:'Type',hours:'Opening information',rating:'Live rating and reviews',ratingLink:'Check on Google Maps',fee:'Tickets and admission',travel:'Getting there',history:'History and cultural background',character:'Architecture, landscape and distinctive features',observe:'What to observe on site',duration:'Suggested visit time',weather:'Visitor tips',location:'Map location',verify:'Exact street address: open the named Google Maps place listing before departure'},
 th:{category:'ประเภทสถานที่',hours:'ข้อมูลเวลาเปิด',rating:'คะแนนและรีวิวล่าสุด',ratingLink:'ตรวจใน Google Maps',fee:'ค่าเข้าและบัตร',travel:'วิธีเดินทาง',history:'ประวัติศาสตร์และวัฒนธรรม',character:'สถาปัตยกรรม ภูมิประเทศ และจุดเด่น',observe:'สิ่งที่ควรสังเกต',duration:'เวลาที่ควรเผื่อ',weather:'ข้อควรรู้ก่อนเยี่ยมชม',location:'ตำแหน่งบนแผนที่',verify:'ที่อยู่ทางเข้าโดยละเอียด: เปิดรายการสถานที่ชื่อเดียวกันใน Google Maps ก่อนออกเดินทาง'},
 zh:{category:'景点类型',hours:'开放信息',rating:'实时评分与评价',ratingLink:'前往 Google 地图核对',fee:'门票与收费',travel:'交通方式',history:'历史背景与人文',character:'建筑、地形及景观特色',observe:'现场观察重点',duration:'建议预留时间',weather:'游览须知',location:'地图位置',verify:'具体入口与门牌地址：出发前请在 Google 地图的同名景点列表核对'},
};
const e=extraLabels[lang];
---

<TopicLayout
  lang={lang}
  title={topic.title}
  description={topic.description}
  path={`/${lang}/${slug}/`}
  faqs={topic.faq}
  breadcrumb={topic.breadcrumb}
  messages={messages}
  alternateLanguages={alternateLanguages}
>
  <!-- Page header -->
  <section class="pt-28 pb-10 bg-teakDeep text-ivory">
    <div class="max-w-4xl mx-auto px-5">
      <nav aria-label="Breadcrumb" class="text-sm text-ivory/60">
        <ol class="flex flex-wrap items-center gap-2">
          {topic.breadcrumb.map((b, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span class="text-gold" aria-hidden="true">→</span>}
              <a href={b.url} class="hover:text-goldBright transition-colors">{b.name}</a>
            </li>
          ))}
        </ol>
      </nav>
      <h1 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-4 gold-text-bright">{topic.h1}</h1>
      <p class="mt-4 text-ivory/85 leading-relaxed">{topic.intro}</p>
      {topic.expandedFacts && <div class="flex flex-wrap gap-3 mt-5 text-sm"><span class="rounded-full border border-gold/50 px-4 py-2">{topic.expandedFacts.category}</span><span class="rounded-full border border-gold/50 px-4 py-2">{e.hours}：{topic.expandedFacts.opening}</span><a class="rounded-full border border-gold/50 px-4 py-2 hover:text-goldBright" href={mapsUrl} target="_blank" rel="noopener">{e.rating}：{e.ratingLink} ↗</a></div>}
      {topic.management && <a href={mapsUrl} target="_blank" rel="noopener" class="inline-flex mt-5 rounded-full bg-gold px-5 py-2.5 font-semibold text-teak hover:bg-goldBright">{u.map}：{topic.h1} ↗</a>}
      {topic.updated && <span class="chip text-goldBright border-gold/40 mt-5 inline-flex">{topic.updated}</span>}
    </div>
  </section>

  {topic.management && (
    <section class="py-14 bg-white text-ink">
      <div class="max-w-4xl mx-auto px-5">
        <p class="uppercase tracking-widest text-sm text-gold">{u.about}</p>
        <h2 class="font-display text-2xl md:text-3xl text-teak mt-2 mb-4">{u.manager}：{topic.h1}</h2>
        <p class="leading-relaxed text-ink/85">{topic.management}</p>
        <p class="mt-4 leading-relaxed text-ink/75">{topic.sections[0]?.body[0]}</p>
      </div>
    </section>
  )}

  {topic.management && (
    <section class="bg-ivory py-12 text-ink">
      <div class="max-w-4xl mx-auto px-5">
        <h2 class="font-display text-2xl text-teak mb-5">{u.basic}</h2>
        {topic.expandedFacts ? <dl class="grid sm:grid-cols-2 gap-4">
          {[[u.destination,topic.h1],[e.category,topic.expandedFacts.category],[e.location,topic.expandedFacts.locality],[e.hours,topic.expandedFacts.opening],[e.fee,topic.expandedFacts.admission],[e.duration,topic.expandedFacts.visitDuration]].map(([name,value])=><div class="rounded-xl bg-white/80 border border-gold/25 p-5"><dt class="text-sm text-ink/60">{name}</dt><dd class="mt-1 leading-relaxed">{value}</dd></div>)}
          <div class="rounded-xl bg-white/80 border border-gold/25 p-5 sm:col-span-2"><dt class="text-sm text-ink/60">{u.navigation}</dt><dd class="mt-1"><a class="text-teak underline underline-offset-4" href={mapsUrl} target="_blank" rel="noopener">{u.navLink}：{topic.h1} ↗</a></dd><p class="text-sm text-ink/65 mt-2">{e.verify}</p></div>
        </dl> : <dl class="grid sm:grid-cols-2 gap-4">
          <div class="rounded-xl bg-white/80 border border-gold/25 p-5"><dt class="text-sm text-ink/60">{u.destination}</dt><dd class="font-semibold mt-1">{topic.h1}</dd></div>
          <div class="rounded-xl bg-white/80 border border-gold/25 p-5"><dt class="text-sm text-ink/60">{u.area}</dt><dd class="font-semibold mt-1">{lang==='th'?'หัวหิน / ประจวบคีรีขันธ์ ประเทศไทย':lang==='zh'?'泰国班武里府／华欣':'Hua Hin / Prachuap Khiri Khan, Thailand'}</dd></div>
          <div class="rounded-xl bg-white/80 border border-gold/25 p-5"><dt class="text-sm text-ink/60">{u.hours}</dt><dd class="mt-1">{u.hoursText}</dd></div>
          <div class="rounded-xl bg-white/80 border border-gold/25 p-5"><dt class="text-sm text-ink/60">{u.navigation}</dt><dd class="mt-1"><a class="text-teak underline underline-offset-4" href={mapsUrl} target="_blank" rel="noopener">{u.navLink} ↗</a></dd></div>
        </dl>}
      </div>
    </section>
  )}

  {topic.expandedFacts && <section class="bg-white py-14 text-ink"><div class="max-w-4xl mx-auto px-5 space-y-10">
    <div><h2 class="font-display text-2xl md:text-3xl text-teak mb-3">{e.history}：{topic.h1}</h2><p class="leading-relaxed text-ink/85">{topic.expandedFacts.history}</p></div>
    <div><h2 class="font-display text-2xl md:text-3xl text-teak mb-3">{e.character}</h2><p class="leading-relaxed text-ink/85">{topic.expandedFacts.character}</p></div>
    <div><h2 class="font-display text-2xl md:text-3xl text-teak mb-3">{e.observe}</h2><p class="leading-relaxed text-ink/85">{topic.expandedFacts.observation}</p></div>
    <div><h2 class="font-display text-2xl md:text-3xl text-teak mb-3">{e.travel}</h2><p class="leading-relaxed text-ink/85">{topic.expandedFacts.transport}</p><a href={mapsUrl} target="_blank" rel="noopener" class="mt-3 inline-block text-teak underline underline-offset-4">{e.ratingLink}：{topic.h1} ↗</a></div>
  </div></section>}

  <!-- Body sections -->
  <section class="py-14 bg-ivory text-ink">
    <div class="max-w-4xl mx-auto px-5 space-y-12">
      {topic.sections.map((s) => (
        <div>
          <h2 class="font-display text-2xl md:text-3xl text-teak mb-4">{s.heading}</h2>
          <div class="space-y-3 text-ink/85">
            {s.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
      ))}

      {topic.kings && (
        <div>
          <h2 class="font-display text-2xl md:text-3xl text-teak mb-5">{u.kings}</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {topic.kings.map((k) => (
              <div class="rounded-xl border border-gold/25 bg-white/50 p-5">
                <div class="text-xs uppercase tracking-wider text-gold/80 mb-1">{k.period}</div>
                <h3 class="font-display text-lg text-teak mb-2">{k.name}</h3>
                <p class="text-sm text-ink/75 leading-relaxed">{k.contribution}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      {topic.photoTips && (
        <div>
          <h2 class="font-display text-2xl md:text-3xl text-teak mb-5">{u.photo}</h2>
          <ol class="grid sm:grid-cols-2 gap-4">
            {topic.photoTips.map((tip, i) => (
              <li class="bg-white/70 border border-gold/25 rounded-xl p-5"><span class="text-gold font-semibold">{String(i + 1).padStart(2, '0')}</span><p class="mt-2 text-ink/85">{tip}</p></li>
            ))}
          </ol>
        </div>
      )}

      {topic.routeSteps && (
        <div>
          <h2 class="font-display text-2xl md:text-3xl text-teak mb-5">{u.route}</h2>
          <ol class="space-y-4">
            {topic.routeSteps.map((step, i) => (
              <li class="flex gap-4 bg-white/70 rounded-xl border border-gold/20 p-5">
                <span class="shrink-0 flex items-center justify-center rounded-full bg-teak text-goldBright w-9 h-9 font-bold">{i + 1}</span>
                <p class="text-ink/85 leading-relaxed">{step}</p>
              </li>
            ))}
          </ol>
        </div>
      )}

      {topic.management && (
        <div class="rounded-xl bg-white/70 border border-gold/25 p-6">
          <h2 class="font-display text-2xl text-teak">{u.stay}</h2>
          <p class="mt-3 text-ink/80 leading-relaxed">{u.stayText}</p>
          <h3 class="font-display text-lg text-teak mt-6">{u.feedback}</h3>
          <p class="mt-2 text-ink/80">{u.feedbackText}</p>
          <a href={mapsUrl} target="_blank" rel="noopener" class="inline-flex mt-3 text-teak underline underline-offset-4">{u.reviews} ↗</a>
        </div>
      )}

      {topic.images && topic.images.length > 0 && (
        <div>
          <h2 class="font-display text-2xl md:text-3xl text-teak mb-5">{u.photos}：{topic.h1}</h2>
          <div class="grid sm:grid-cols-2 gap-5">
            {topic.images.map((photo) => (
              <figure class="rounded-xl overflow-hidden bg-white border border-gold/20">
                <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" class="w-full h-64 object-cover" />
                <figcaption class="text-xs text-ink/65 px-4 py-3">{photo.alt}{photo.credit && ` · ${photo.credit}`}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-14 bg-teakDeep text-ivory">
    <div class="max-w-3xl mx-auto px-5">
      <h2 class="font-display text-2xl md:text-3xl text-goldBright mb-6">{u.faq}</h2>
      <div class="space-y-3">
        {topic.faq.map((f) => (
          <details class="group rounded-xl border border-gold/25 bg-teak/40 p-4 open:bg-teak/60">
            <summary class="cursor-pointer font-medium text-ivory flex justify-between items-center">
              {f.q}
              <span class="text-gold transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-2 text-sm text-ivory/80">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related links -->
  <section class="py-14 bg-ivory text-ink">
    <div class="max-w-4xl mx-auto px-5">
      <h2 class="font-display text-2xl text-teak mb-5">{u.related}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {topic.related.map((r) => (
          <a href={r.url} class="rounded-xl border border-gold/30 bg-white/50 p-5 hover:border-gold/60 transition-colors">
            <div class="font-display text-lg text-teak mb-1">{r.title}</div>
            <p class="text-sm text-ink/70">{r.desc}</p>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 bg-gold text-teak font-semibold px-5 py-2.5 rounded-full hover:bg-goldBright transition-colors"
        >
          {u.map}：{topic.h1} ↗
        </a>
      </div>
    </div>
  </section>
</TopicLayout>
