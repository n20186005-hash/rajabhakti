---
import { topics } from '../../i18n/topics';
import { getI18n, languagesList, type Lang } from '../../i18n/ui';
import TopicLayout from '../../layouts/TopicLayout.astro';
export function getStaticPaths(){return languagesList.filter(lang=>lang!=='en').map(lang=>({params:{lang}}));}
const {lang,messages}=await getI18n(Astro.url);
const all=topics.filter(t=>t.lang===lang);
const nearby=all.filter(t=>t.slug.startsWith('nearby-'));
const practical=all.filter(t=>!t.slug.startsWith('nearby-'));
const copy:Record<Lang,{title:string;description:string;nearby:string;practical:string;read:string;back:string}>={
en:{title:'Explore Hua Hin and Rajabhakti Park',description:'Plan meaningful stops around the seven kings’ monument. Every guide includes a dedicated map and distinct practical tips.',nearby:'Nearby Hua Hin attractions',practical:'History, transport and practical guides',read:'Read guide',back:'Rajabhakti Park'},
th:{title:'เที่ยวหัวหินและอุทยานราชภักดิ์',description:'วางแผนเดินทางรอบอนุสรณ์เจ็ดบูรพกษัตริย์ แต่ละคู่มือมีแผนที่เฉพาะจุด ประวัติและข้อควรรู้สำหรับนักท่องเที่ยว',nearby:'สถานที่ท่องเที่ยวรอบหัวหิน',practical:'ประวัติศาสตร์ การเดินทาง และคู่มือท่องเที่ยว',read:'อ่านคู่มือ',back:'อุทยานราชภักดิ์'},
zh:{title:'探索华欣与七王纪念园',description:'从七王纪念园出发规划周边行程。每篇攻略均有独立的地图位置、历史背景、观察重点与实用提示。',nearby:'华欣周边景点',practical:'历史、交通与实用攻略',read:'阅读攻略',back:'七王纪念园'},
};
const c=copy[lang];
---
<TopicLayout lang={lang} title={c.title} description={c.description} path={`/${lang}/explore/`} faqs={[]} breadcrumb={[{name:c.back,url:`/${lang}/`},{name:c.title,url:`/${lang}/explore/`}]} messages={messages} alternateLanguages={languagesList.map(l=>({lang:l,path:`/${l}/explore/`}))}>
  <section class="pt-28 pb-16 bg-teakDeep text-ivory"><div class="max-w-6xl mx-auto px-5"><a href={`/${lang}/`} class="text-goldBright text-sm">← {c.back}</a><h1 class="font-display text-3xl md:text-5xl mt-5 text-goldBright">{c.title}</h1><p class="mt-4 max-w-3xl text-ivory/85 leading-relaxed">{c.description}</p></div></section>
  <div class="bg-ivory py-14 text-ink"><div class="max-w-6xl mx-auto px-5 space-y-14">
    {[{heading:c.nearby,items:nearby},{heading:c.practical,items:practical}].map(section=><section><h2 class="font-display text-2xl md:text-3xl text-teak mb-6">{section.heading}</h2><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">{section.items.map(t=><a href={`/${lang}/${t.slug}/`} class="rounded-xl border border-gold/30 bg-white/70 p-5 hover:border-gold transition-colors"><h3 class="font-display text-lg text-teak">{t.h1}</h3><p class="text-sm mt-2 text-ink/75">{t.description}</p><span class="text-gold text-sm mt-4 inline-block">{c.read} →</span></a>)}</div></section>)}
  </div></div>
</TopicLayout>
