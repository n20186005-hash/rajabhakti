---
import '../styles/global.css';
import { siteConfig } from '../config';
import { htmlLang, languagesList, type Lang } from '../i18n/ui';

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  lang: Lang;
  title: string;
  description: string;
  faqs?: FaqItem[];
}

const { lang, title, description, faqs } = Astro.props;
const canonical = `${siteConfig.domain}/${lang}/`;
const heroImage = `${siteConfig.domain}/gallery/rajabhakti-park-1.jpg`;
const heroImageAlt = `${siteConfig.name.en} (${siteConfig.name.th}) — ${siteConfig.addressParts.addressLocality}, Thailand`;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    '@id': `${siteConfig.domain}/#attraction`,
    name: siteConfig.name[lang],
    alternateName: [
      siteConfig.name.th,
      siteConfig.name.en,
      `${siteConfig.addressParts.addressLocality} ${siteConfig.name.en}`,
    ],
    description,
    url: canonical,
    image: [heroImage],
    isAccessibleForFree: true,
    hasMap: siteConfig.mapsUrl,
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteConfig.addressParts.streetAddress,
      addressLocality: siteConfig.addressParts.addressLocality,
      addressRegion: siteConfig.addressParts.addressRegion,
      postalCode: siteConfig.addressParts.postalCode,
      addressCountry: siteConfig.addressParts.addressCountry,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: siteConfig.coords.lat,
      longitude: siteConfig.coords.lng,
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: siteConfig.rating,
      reviewCount: siteConfig.reviewCount.replace(/,/g, ''),
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '08:00',
        closes: '18:00',
      },
    ],
    sameAs: siteConfig.sameAs,
  },
];

// FAQPage structured data — only emitted on pages that pass visible FAQ content
if (faqs && faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  });
}
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#071a1c" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.name.en} />

    <link rel="icon" type="image/jpeg" href={`/gallery/rajabhakti-park-1.jpg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={heroImage} />
    <meta property="og:image:alt" content={heroImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {languagesList.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={`${siteConfig.domain}/${l}/`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteConfig.domain}/th/`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Trirong:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Sarabun:wght@300;400;500;600;700&family=Charm:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="grain">
    <slot />

    <!-- PWA service worker -->
    <script>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
